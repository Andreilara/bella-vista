
# Starting password for the first administrator account (username: admin). Change it under My account after signing in.
ADMIN_PASSCODE=choose-a-long-passcode
# Public URL of the site (used in links, the sitemap, share previews and voucher QR codes).
# REQUIRED to build: `npm run build` stops while this is missing or a placeholder. (Testing only: ALLOW_PLACEHOLDER_SITE=1 npm run build.)
# NEXT_PUBLIC_SITE_URL is fixed when you build; SITE_URL (optional) is read when the server starts and wins if both are set.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# SITE_URL=https://yourdomain.com
# Optional: where the SQLite file lives (default: data/bella-vista.db)
# DB_PATH=/var/data/bella-vista.db
# Vercel uses Turso by default. Set both as server-only variables.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# For testing against Turso outside Vercel, explicitly opt in with DB_PROVIDER=turso.

# Email (optional). Works on localhost too: use a real mailbox (Gmail app password) or a test inbox such as Mailtrap. Restart after changing it.
# For links inside emails to open your local site, set NEXT_PUBLIC_SITE_URL=http://localhost:3000 while testing. Without these, guests see their reference on screen only and "Lost your reference?" tells them to contact the hotel.
# SMTP_URL=smtps://reservations%40yourdomain.com:app-password@smtp.yourprovider.com:465
# MAIL_FROM="Bella Vista <reservations@yourdomain.com>"
